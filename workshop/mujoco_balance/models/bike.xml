<mujoco model="balance_bike">
  <compiler angle="degree" autolimits="true" inertiafromgeom="auto"/>

  <option timestep="0.002" integrator="implicitfast" gravity="0 0 -9.81" cone="elliptic"/>
  <statistic center="3 0 0.9" extent="5"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0.1 0.1 0.1"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="140" elevation="-20" offwidth="1280" offheight="720"/>
  </visual>

  <default>
    <joint damping="0.02" armature="0.004"/>
    <geom friction="1.5 0.01 0.001" condim="3" solref="0.008 1"/>
    <motor ctrllimited="true" ctrlrange="-22 22"/>
  </default>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.22 0.32 0.42" rgb2="0.02 0.04 0.08" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge"
             rgb1="0.34 0.38 0.32" rgb2="0.22 0.26 0.22" markrgb="0.16 0.18 0.15"
             width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="10 10" reflectance="0.12"/>
    <hfield name="ground" nrow="8" ncol="400" size="14 2.0 0.45 0.12"/>
    <material name="frame" rgba="0.12 0.13 0.16 1"/>
    <material name="accent" rgba="0.93 0.38 0.16 1"/>
    <material name="wheel" rgba="0.18 0.18 0.2 1"/>
    <material name="tire" rgba="0.07 0.07 0.08 1"/>
    <material name="seat" rgba="0.28 0.18 0.12 1"/>
  </asset>

  <worldbody>
    <light pos="0 -1.5 3.2" dir="0 0.3 -1" diffuse="0.8 0.8 0.75" specular="0.3 0.3 0.3"/>
    <geom name="terrain" type="hfield" hfield="ground" material="groundplane" pos="0 0 0"
          friction="1.5 0.01 0.001"/>
    <!-- Visual-only: brown mounds + yellow pins mark each small hill (far side of the lane). -->
    <geom name="hill_0" type="ellipsoid" size="1 0.5 0.12" pos="0 0 -2" rgba="0.55 0.38 0.18 1" contype="0" conaffinity="0"/>
    <geom name="hill_1" type="ellipsoid" size="1 0.5 0.12" pos="0 0 -2" rgba="0.55 0.38 0.18 1" contype="0" conaffinity="0"/>
    <geom name="hill_2" type="ellipsoid" size="1 0.5 0.12" pos="0 0 -2" rgba="0.55 0.38 0.18 1" contype="0" conaffinity="0"/>
    <geom name="hill_3" type="ellipsoid" size="1 0.5 0.12" pos="0 0 -2" rgba="0.55 0.38 0.18 1" contype="0" conaffinity="0"/>
    <geom name="hill_4" type="ellipsoid" size="1 0.5 0.12" pos="0 0 -2" rgba="0.55 0.38 0.18 1" contype="0" conaffinity="0"/>
    <geom name="hill_5" type="ellipsoid" size="1 0.5 0.12" pos="0 0 -2" rgba="0.55 0.38 0.18 1" contype="0" conaffinity="0"/>
    <geom name="pin_0" type="sphere" size="0.05" pos="0 0 -2" rgba="1 0.85 0.15 1" contype="0" conaffinity="0"/>
    <geom name="pin_1" type="sphere" size="0.05" pos="0 0 -2" rgba="1 0.85 0.15 1" contype="0" conaffinity="0"/>
    <geom name="pin_2" type="sphere" size="0.05" pos="0 0 -2" rgba="1 0.85 0.15 1" contype="0" conaffinity="0"/>
    <geom name="pin_3" type="sphere" size="0.05" pos="0 0 -2" rgba="1 0.85 0.15 1" contype="0" conaffinity="0"/>
    <geom name="pin_4" type="sphere" size="0.05" pos="0 0 -2" rgba="1 0.85 0.15 1" contype="0" conaffinity="0"/>
    <geom name="pin_5" type="sphere" size="0.05" pos="0 0 -2" rgba="1 0.85 0.15 1" contype="0" conaffinity="0"/>

    <!-- Cart (wheels) stays on the floor. Frame is an inverted pendulum hinged at the axle line. -->
    <body name="cart" pos="0 0 0.16">
      <inertial pos="0 0 0" mass="3.0" diaginertia="0.05 0.12 0.08"/>
      <joint name="slide_x" type="slide" axis="1 0 0" damping="0.15"/>
      <joint name="slide_z" type="slide" axis="0 0 1" damping="3.0" stiffness="0" limited="true" range="-0.05 0.50"/>
      <!-- Side camera rides with the bike and looks a little ahead so bumps are visible. -->
      <camera name="side" pos="1.4 -4.2 0.85" xyaxes="1 0 0 0 0.16 0.99" fovy="46"/>
      <camera name="follow" pos="-2.2 -3.2 0.9" xyaxes="0.82 0.57 0 -0.12 0.18 0.98" fovy="50"/>

      <body name="rear_wheel" pos="-0.32 0 0">
        <inertial pos="0 0 0" mass="1.4" diaginertia="0.012 0.022 0.012"/>
        <joint name="rear_axle" type="hinge" axis="0 1 0" damping="0.002"/>
        <geom name="rear_tire" type="cylinder" size="0.16 0.018" zaxis="0 1 0" material="tire"/>
        <geom name="rear_hub" type="cylinder" size="0.035 0.022" zaxis="0 1 0" material="wheel"/>
        <geom name="rear_spoke_a" type="capsule" fromto="0 0 -0.13 0 0 0.13" size="0.006" material="wheel"/>
        <geom name="rear_spoke_b" type="capsule" fromto="-0.13 0 0 0.13 0 0" size="0.006" material="wheel"/>
      </body>

      <body name="front_wheel" pos="0.32 0 0">
        <inertial pos="0 0 0" mass="1.2" diaginertia="0.011 0.020 0.011"/>
        <joint name="front_axle" type="hinge" axis="0 1 0" damping="0.002"/>
        <geom name="front_tire" type="cylinder" size="0.16 0.018" zaxis="0 1 0" material="tire"/>
        <geom name="front_hub" type="cylinder" size="0.035 0.022" zaxis="0 1 0" material="wheel"/>
        <geom name="front_spoke_a" type="capsule" fromto="0 0 -0.13 0 0 0.13" size="0.006" material="wheel"/>
        <geom name="front_spoke_b" type="capsule" fromto="-0.13 0 0 0.13 0 0" size="0.006" material="wheel"/>
      </body>

      <body name="frame" pos="0 0 0">
        <inertial pos="0 0 0.42" mass="16.0" diaginertia="0.55 0.95 0.55"/>
        <joint name="pitch" type="hinge" axis="0 1 0" damping="0.01" limited="true" range="-70 70"/>

        <geom name="downtube" type="capsule" fromto="-0.28 0 0.02 0.18 0 0.34" size="0.022" material="frame"
              contype="0" conaffinity="0"/>
        <geom name="seattube" type="capsule" fromto="-0.05 0 0.02 -0.08 0 0.40" size="0.022" material="frame"
              contype="0" conaffinity="0"/>
        <geom name="toptube" type="capsule" fromto="-0.08 0 0.40 0.18 0 0.34" size="0.020" material="frame"
              contype="0" conaffinity="0"/>
        <geom name="chainstay" type="capsule" fromto="-0.32 0 0.00 -0.05 0 0.02" size="0.014" material="frame"
              contype="0" conaffinity="0"/>
        <geom name="seatstay" type="capsule" fromto="-0.32 0 0.00 -0.08 0 0.40" size="0.012" material="frame"
              contype="0" conaffinity="0"/>
        <geom name="fork" type="capsule" fromto="0.18 0 0.34 0.32 0 0.00" size="0.016" material="accent"
              contype="0" conaffinity="0"/>
        <geom name="handlebar" type="capsule" fromto="0.16 -0.12 0.36 0.16 0.12 0.36" size="0.012" material="accent"
              contype="0" conaffinity="0"/>
        <geom name="saddle" type="box" pos="-0.10 0 0.44" size="0.08 0.04 0.018" material="seat"
              contype="0" conaffinity="0"/>
        <geom name="rider" type="capsule" fromto="-0.10 0 0.50 -0.05 0 0.82" size="0.055"
              rgba="0.75 0.55 0.42 1" contype="0" conaffinity="0"/>
      </body>
    </body>
  </worldbody>

  <contact>
    <exclude body1="frame" body2="rear_wheel"/>
    <exclude body1="frame" body2="front_wheel"/>
    <exclude body1="frame" body2="cart"/>
  </contact>

  <actuator>
    <motor name="drive" joint="slide_x" gear="1" ctrlrange="-250 250"/>
    <motor name="rear_drive" joint="rear_axle" gear="1"/>
    <motor name="front_drive" joint="front_axle" gear="1"/>
  </actuator>

  <sensor>
    <jointpos name="pitch" joint="pitch"/>
    <jointvel name="pitch_vel" joint="pitch"/>
    <jointpos name="x" joint="slide_x"/>
    <jointvel name="x_vel" joint="slide_x"/>
    <jointpos name="z" joint="slide_z"/>
    <jointvel name="z_vel" joint="slide_z"/>
    <jointvel name="rear_spin" joint="rear_axle"/>
  </sensor>
</mujoco>
